{
  "name": "besnovatyj/yii2-cms-route-alias",
  "description": "Управляемые из админки короткие URL (алиасы маршрутов) фронтенда для Yii2 CMS",
  "type": "yii2-extension",
  "license": "MIT",
  "authors": [
    {
      "name": "Besnovatyj",
      "email": "your-email@example.com"
    }
  ],
  "minimum-stability": "stable",
  "extra": {
    "moduleClass": "Besnovatyj\\RouteAlias\\Module",
    "moduleId": "RouteAlias",
    "bescms": { "kind": "module" },
    "config-plugin": {
      "admin-menu": "src/config/adminMenu.php",
      "common": "src/config/common.php"
    }
  },
  "keywords": [
    "yii2",
    "cms",
    "url",
    "alias",
    "routing",
    "permalink"
  ],
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    },
    "fxp-asset": {
      "enabled": false
    }
  },
  "require": {
    "besnovatyj/yii2-cms-kernel": "^1.2",
    "besnovatyj/yii2-cms-contracts": "^3.0",
    "besnovatyj/yii2-cms-forms": "^1.0",
    "besnovatyj/yii2-cms-backend-widgets": "^1.0",
    "php": ">=8.4",
    "yiisoft/yii2": "~2.0.0",
    "yiisoft/yii2-bootstrap5": "~2.0.0"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest"
  },
  "autoload": {
    "psr-4": {
      "Besnovatyj\\RouteAlias\\": "src/"
    }
  }
}
